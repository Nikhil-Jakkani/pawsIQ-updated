model ChatConversation {
  conversation_id       Int                   @id @default(autoincrement())
  topic                 String?               @db.VarChar(200)
  context_type          String?               @db.VarChar(50)
  is_archived           Boolean               @default(false)
  created_by_user_id    BigInt?
  created_by_provider_id Int?
  created_by_admin_id   BigInt?
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  last_message_at       DateTime?             @db.Timestamptz(6)
  participants          ChatParticipant[]
  messages              ChatMessage[]
  creator_user          PIQ_User?             @relation("ChatConversationCreatedByUser", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
  creator_provider      PIQ_Service_Provider? @relation("ChatConversationCreatedByProvider", fields: [created_by_provider_id], references: [service_provider_id], onDelete: SetNull)
  creator_admin         PIQ_Admins?           @relation("ChatConversationCreatedByAdmin", fields: [created_by_admin_id], references: [admin_id], onDelete: SetNull)

  @@index([is_archived], map: "idx_chat_conversation_archived")
  @@index([last_message_at], map: "idx_chat_conversation_last_message")
  @@index([created_by_user_id], map: "idx_chat_conversation_created_user")
  @@index([created_by_provider_id], map: "idx_chat_conversation_created_provider")
  @@index([created_by_admin_id], map: "idx_chat_conversation_created_admin")
  @@map("chat_conversations")
}

model ChatParticipant {
  participant_id  Int                @id @default(autoincrement())
  conversation_id Int
  role            String             @db.VarChar(20)
  user_id         BigInt?
  provider_id     Int?
  admin_id        BigInt?
  last_read_at    DateTime?          @db.Timestamptz(6)
  joined_at       DateTime           @default(now()) @db.Timestamptz(6)
  conversation    ChatConversation  @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, map: "fk_chat_participant_conversation")
  user            PIQ_User?          @relation("ChatParticipantUser", fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_chat_participant_user")
  provider        PIQ_Service_Provider? @relation("ChatParticipantProvider", fields: [provider_id], references: [service_provider_id], onDelete: Cascade, map: "fk_chat_participant_provider")
  admin           PIQ_Admins?        @relation("ChatParticipantAdmin", fields: [admin_id], references: [admin_id], onDelete: Cascade, map: "fk_chat_participant_admin")

  @@index([conversation_id], map: "idx_chat_participant_conversation")
  @@index([user_id], map: "idx_chat_participant_user")
  @@index([provider_id], map: "idx_chat_participant_provider")
  @@index([admin_id], map: "idx_chat_participant_admin")
  @@unique([conversation_id, user_id], map: "uq_chat_participant_user")
  @@unique([conversation_id, provider_id], map: "uq_chat_participant_provider")
  @@unique([conversation_id, admin_id], map: "uq_chat_participant_admin")
  @@map("chat_participants")
}

model ChatMessage {
  message_id         Int                @id @default(autoincrement())
  conversation_id    Int
  author_role        String             @db.VarChar(20)
  author_user_id     BigInt?
  author_provider_id Int?
  author_admin_id    BigInt?
  message_body       String             @db.VarChar(4000)
  attachments        Json               @default("[]")
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @updatedAt @db.Timestamptz(6)
  conversation       ChatConversation  @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, map: "fk_chat_message_conversation")
  author_user        PIQ_User?          @relation("ChatMessageAuthorUser", fields: [author_user_id], references: [user_id], onDelete: SetNull)
  author_provider    PIQ_Service_Provider? @relation("ChatMessageAuthorProvider", fields: [author_provider_id], references: [service_provider_id], onDelete: SetNull)
  author_admin       PIQ_Admins?        @relation("ChatMessageAuthorAdmin", fields: [author_admin_id], references: [admin_id], onDelete: SetNull)

  @@index([conversation_id], map: "idx_chat_message_conversation")
  @@index([author_user_id], map: "idx_chat_message_author_user")
  @@index([author_provider_id], map: "idx_chat_message_author_provider")
  @@index([author_admin_id], map: "idx_chat_message_author_admin")
  @@index([created_at], map: "idx_chat_message_created_at")
  @@map("chat_messages")
}
