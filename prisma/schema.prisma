generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PIQ_Health_Records {
  health_record_id BigInt    @id @default(autoincrement())
  pet_id           BigInt
  record_type      String    @db.VarChar(50)
  title            String    @db.VarChar(255)
  description      String?
  record_date      DateTime  @db.Date
  next_due_date    DateTime? @db.Date
  file_path        String    @db.VarChar(512)
  file_name        String    @db.VarChar(255)
  file_type        String    @db.VarChar(100)
  file_size        Int
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm DateTime? @default(now()) @db.Timestamp(6)
  PIQ_Pets         PIQ_Pets  @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade)

  @@index([pet_id], map: "idx_health_records_pet_id")
  @@index([record_type], map: "idx_health_records_record_type")
  @@index([record_date], map: "idx_health_records_record_date")
}

model PIQ_Pets {
  pet_id                    BigInt                     @id @default(autoincrement())
  user_id                   BigInt?
  pet_type                  String?                    @db.VarChar
  pet_name                  String?                    @db.VarChar
  pet_breed                 String?                    @db.VarChar
  pet_gender                String?                    @db.VarChar
  pet_birth_dtm             DateTime?                  @db.Date
  pet_blood_grp             String?                    @db.VarChar
  pet_status                String?                    @db.VarChar
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  last_updated_dtm          DateTime?                  @default(now()) @db.Timestamp(6)
  pet_image                 String?
  pet_colour                String?
  microchipped              Boolean?                   @default(false)
  neutered                  Boolean?                   @default(false)
  vaccinated                Boolean?                   @default(false)
  extras                    Json?                      @default("{}")
  pet_weight                Int?                       @db.SmallInt
  microchip_number          BigInt?
  PIQ_Appointments          PIQ_Appointments[]
  PIQ_Bookings              PIQ_Bookings[]
  PIQ_Health_Records        PIQ_Health_Records[]
  PIQ_Pet_Allergy           PIQ_Pet_Allergy?
  PIQ_Pet_Medical_Condition PIQ_Pet_Medical_Condition?
  PIQ_Pet_Vaccination       PIQ_Pet_Vaccination?
  PIQ_User                  PIQ_User?                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  PIQ_Pets_Photo            PIQ_Pets_Photo[]
  PIQ_Reminders             PIQ_Reminders[]
  PIQ_pets_profile          PIQ_pets_profile[]

  @@index([pet_name], map: "idx_pets_name")
  @@index([user_id], map: "idx_pets_user_id")
}

model PIQ_Pets_Photo {
  pet_photo_id     BigInt    @id @default(autoincrement())
  pet_id           BigInt?
  pet_photo        Bytes?
  is_photo_default Boolean?
  photo_shareable  Boolean?
  photo_url        String?   @db.VarChar
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm DateTime? @default(now()) @db.Timestamp(6)
  PIQ_Pets         PIQ_Pets? @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction)
}

model PIQ_Service_Master {
  services_id                   Int                             @id @default(autoincrement())
  service_type                  String                          @db.VarChar
  service_sub_type              String                          @db.VarChar
  service_title                 String                          @db.VarChar
  service_description           String                          @db.VarChar
  service_price_amt             Int
  service_duration              Int                             @db.SmallInt
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  last_updated_dtm              DateTime?                       @db.Timestamp(6)
  is_record_valid               Boolean?
  pet_type                      String?                         @db.VarChar
  PIQ_Bookings                  PIQ_Bookings[]
  PIQ_Provider_Availability     PIQ_Provider_Availability[]
  PIQ_Provider_ServiceOffering  PIQ_Provider_ServiceOffering[]
  PIQ_Provider_ServicePricing   PIQ_Provider_ServicePricing[]
  PIQ_Service_BizEntity_Details PIQ_Service_BizEntity_Details[]
}

model PIQ_Service_Provider {
  service_provider_id            Int                              @id @default(autoincrement())
  serv_provider_name             String?                          @db.VarChar
  serv_provider_email            String?                          @db.VarChar
  serv_provider_contact_nbr      String?                          @db.VarChar
  serv_provider_password         String?                          @db.VarChar
  serv_provider_exp_years        String?                          @db.VarChar
  serv_provider_certificates     String?                          @db.VarChar
  serv_provider_photo            Bytes?
  serv_provider_desc             String?                          @db.VarChar
  serv_provider_status           String?                          @default("inactive") @db.VarChar
  serv_provider_request_dtm      DateTime?                        @default(now()) @db.Timestamp(6)
  serv_provider_approval_dtm     DateTime?                        @db.Timestamp(6)
  provider_src                   String?                          @db.VarChar
  is_provider_bgchecked          Boolean?
  serv_provider_insta_acct_dtls  String?                          @db.VarChar
  serv_provider_fb_acct_dtls     String?                          @db.VarChar
  is_record_valid                Boolean?
  last_updated_dtm               DateTime?                        @db.Timestamp(6)
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  serv_provider_type             String?
  how_hear_about_us              String?                          @db.VarChar
  serv_provider_location         String?                          @db.VarChar
  clinic_address_line1           String?                          @db.VarChar(255)
  clinic_address_line2           String?                          @db.VarChar(255)
  clinic_city                    String?                          @db.VarChar(100)
  clinic_country                 String?                          @db.VarChar(100)
  clinic_hours                   String?                          @db.VarChar(255)
  clinic_name                    String?                          @db.VarChar(255)
  clinic_phone                   String?                          @db.VarChar(50)
  clinic_postal_code             String?                          @db.VarChar(30)
  clinic_state                   String?                          @db.VarChar(100)
  clinic_website                 String?                          @db.VarChar(255)
  cover_photo_url                String?                          @db.VarChar(512)
  languages_spoken               String?                          @db.VarChar(255)
  profile_photo_url              String?                          @db.VarChar(512)
  specializations                String?                          @db.VarChar(500)
  PIQ_Bookings                   PIQ_Bookings[]
  PIQ_Commission                 PIQ_Commission[]
  PIQ_Provider_Availability      PIQ_Provider_Availability[]
  PIQ_Provider_Billing           PIQ_Provider_Billing?
  PIQ_Provider_Dashboard_Metrics PIQ_Provider_Dashboard_Metrics[]
  PIQ_Provider_Documents         PIQ_Provider_Documents[]
  PIQ_Provider_Payouts           PIQ_Provider_Payouts[]
  PIQ_Provider_Portfolio         PIQ_Provider_Portfolio[]
  PIQ_Provider_Reviews           PIQ_Provider_Reviews[]
  PIQ_Provider_ServiceOffering   PIQ_Provider_ServiceOffering[]
  PIQ_Provider_ServicePricing    PIQ_Provider_ServicePricing[]
  SupportTicket                  SupportTicket[]
  TicketMessage                  TicketMessage[]                  @relation("TicketMessageProviderAuthor")
  chat_conversations             ChatConversation[]               @relation("ChatConversationCreatedByProvider")
  chat_participants              ChatParticipant[]                @relation("ChatParticipantProvider")
  chat_messages                  ChatMessage[]                    @relation("ChatMessageAuthorProvider")

  @@index([serv_provider_status], map: "idx_provider_status")
}

model PIQ_Provider_Billing {
  billing_id            Int                  @id @default(autoincrement())
  service_provider_id   Int                  @unique
  payout_method         String?              @db.VarChar(30)
  account_holder_name   String?              @db.VarChar(150)
  account_number        String?              @db.VarChar(34)
  bank_name             String?              @db.VarChar(150)
  bank_branch           String?              @db.VarChar(150)
  ifsc_code             String?              @db.VarChar(20)
  upi_id                String?              @db.VarChar(100)
  pan_number            String?              @db.VarChar(20)
  gst_number            String?              @db.VarChar(20)
  tax_status            String?              @db.VarChar(50)
  payout_frequency      String?              @db.VarChar(30)
  billing_address_line1 String?              @db.VarChar(255)
  billing_address_line2 String?              @db.VarChar(255)
  billing_city          String?              @db.VarChar(100)
  billing_state         String?              @db.VarChar(100)
  billing_postal_code   String?              @db.VarChar(30)
  billing_country       String?              @db.VarChar(100)
  notes                 String?              @db.VarChar(500)
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @updatedAt @db.Timestamptz(6)
  PIQ_Service_Provider  PIQ_Service_Provider @relation(fields: [service_provider_id], references: [service_provider_id], onDelete: Cascade, map: "fk_billing_provider")

  @@index([payout_method], map: "idx_provider_billing_method")
}

model PIQ_User {
  user_id                  BigInt                       @id @default(autoincrement())
  user_full_name           String                       @db.VarChar
  user_email_id            String                       @unique @db.VarChar
  user_password            String
  user_phone_number        String                       @db.VarChar
  user_second_phone_number String?                      @db.VarChar
  user_status              String                       @default("") @db.VarChar
  last_updated_dtm         DateTime                     @default(now()) @db.Timestamp(6)
  created_at               DateTime                     @default(now()) @db.Timestamptz(6)
  paid_user                Boolean?                     @default(false)
  date_of_birth            DateTime?                    @db.Date
  is_active                Boolean                      @default(true)
  profile_picture_url      String?                      @db.VarChar(512)
  user_location            String?                      @db.VarChar(255)
  PIQ_Bookings             PIQ_Bookings[]
  PIQ_Payments             PIQ_Payments[]
  PIQ_Pets                 PIQ_Pets[]
  PIQ_Provider_Reviews     PIQ_Provider_Reviews[]
  PIQ_Reminders            PIQ_Reminders[]
  SupportTicket            SupportTicket[]
  TicketMessage            TicketMessage[]              @relation("TicketMessageUserAuthor")
  notificationPreferences  UserNotificationPreference[]
  password_reset_otps      password_reset_otps[]
  chat_conversations       ChatConversation[]           @relation("ChatConversationCreatedByUser")
  chat_participants        ChatParticipant[]            @relation("ChatParticipantUser")
  chat_messages            ChatMessage[]                @relation("ChatMessageAuthorUser")
}

model UserNotificationPreference {
  preference_id Int      @id @default(autoincrement())
  user_id       BigInt
  channel       String
  key           String
  enabled       Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  PIQ_User      PIQ_User @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, channel, key])
  @@index([user_id])
}

model PIQ_pets_profile {
  pets_profile_id      Int       @id @default(autoincrement())
  pet_id               BigInt
  pet_age              Int?      @db.SmallInt
  pet_weight           Int?      @db.SmallInt
  pet_weight_unit      String?   @db.VarChar
  pet_height           Int?      @db.SmallInt
  pet_height_unit      String?   @db.VarChar
  Is_pet_over_weight   Boolean?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm     DateTime? @default(now()) @db.Timestamp(6)
  body_condition_score Int?      @db.SmallInt
  notes                String?
  PIQ_Pets             PIQ_Pets  @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction)
}

model tokens {
  id          Int       @id @default(autoincrement())
  token       String
  user_id     Int?
  type        String    @db.VarChar(20)
  expires     DateTime  @db.Timestamptz(6)
  blacklisted Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  provider_id Int?

  @@index([token], map: "idx_tokens_token")
  @@index([user_id], map: "idx_tokens_user_id")
  @@index([provider_id], map: "idx_tokens_provider_id")
}

model PIQ_FoodAvoid_Master {
  foodavoid_master_id    Int       @id @default(autoincrement())
  pet_type               String?   @db.VarChar
  pet_breed              String?   @db.VarChar
  pet_gender             String?   @db.VarChar
  pet_size_grp           String?   @db.VarChar
  foodtype_to_avoid      String?   @db.VarChar
  food_to_avoid_examples String?   @db.VarChar
  food_avoid_reason      String?   @db.VarChar
  potential_health_issue String?   @db.VarChar
  health_issue_severity  String?   @db.VarChar
  addtnl_comments        String?   @db.VarChar
  is_record_valid        String?   @db.VarChar
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm       DateTime? @db.Timestamp(6)
}

model PIQ_Food_Master {
  food_master_id      Int       @id @default(autoincrement())
  pet_type            String?   @db.VarChar
  pet_breed           String?   @db.VarChar
  pet_age_grp         String?   @db.VarChar
  food_category       String?   @db.VarChar
  food_example        String?   @db.VarChar
  food_key_nutrients  String?   @db.VarChar
  food_benefits       String?   @db.VarChar
  food_prep_portion   String?   @db.VarChar
  food_feed_frequency String?   @db.VarChar
  food_record_valid   String?   @db.VarChar
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm    DateTime? @db.Timestamp(6)
}

model PIQ_Ideal_Weight_Master {
  pet_wght_mstr_id   Int       @id @default(autoincrement())
  pet_type           String?   @db.VarChar
  pet_gender         String?   @db.VarChar
  pet_breed          String?   @db.VarChar
  pet_built          String?   @db.VarChar
  pet_age_grp        String?   @db.VarChar
  ideal_weight_range String?   @db.VarChar
  ideal_weight_unit  String?   @db.VarChar
  pet_comments       String?   @db.VarChar
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_drm   DateTime? @db.Timestamp(6)
}

model PIQ_Nutrition_Master {
  nutrition_master_id   Int       @id @default(autoincrement())
  pet_type              String?   @db.VarChar
  pet_breed             String?   @db.VarChar
  pet_age               String?   @db.VarChar
  nutrition_name        String?   @db.VarChar
  nutrition_function    String?   @db.VarChar
  nutrition_source      String?   @db.VarChar
  nutrition_daily_split String?   @db.VarChar
  is_record_valid       Boolean?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm      DateTime? @db.Timestamp(6)
}

model PIQ_Petbreed_Master {
  pet_breed_id        Int       @id @default(autoincrement())
  pet_type            String?   @db.VarChar
  pet_breed_name      String?   @db.VarChar
  pet_size            String?   @db.VarChar
  pet_space_needs     String?   @db.VarChar
  pet_exercise_needs  String?   @db.VarChar
  pet_temperament     String?   @db.VarChar
  pet_family_friendly String?   @db.VarChar
  is_record_valid     Boolean?
  last_updated_dtm    DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
}

model PIQ_PreventiveFoodCare_Master {
  preventivecare_master_id BigInt    @id @default(autoincrement())
  pet_type                 String?   @db.VarChar
  pet_breed                String?   @db.VarChar
  common_health_concern    String?   @db.VarChar
  nutritional_focus        String?   @db.VarChar
  recommend_food_types     String?   @db.VarChar
  foods_to_limit           String?   @db.VarChar
  is_record_valid          Boolean?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm         DateTime? @db.Timestamp(6)
}

model PIQ_Vaccine_Master {
  vaccine_mstr_id          Int       @id @default(autoincrement())
  pet_type                 String?   @db.VarChar
  pet_breed_group          String?   @db.VarChar
  pet_breed                String?   @db.VarChar
  pet_age_grp              String?   @db.VarChar
  vaccine_name             String?   @db.VarChar
  vaccine_purpose          String?   @db.VarChar
  vaccine_description_dtls String?   @db.VarChar
  vaccine_pet_age          String?   @db.VarChar
  vaccine_frequency        String?   @db.VarChar
  is_vaccine_core          Boolean?
  is_record_valid          Boolean?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm         DateTime? @db.Timestamp(6)
}

model PIQ_Appointments {
  appointment_id       Int           @id @default(autoincrement())
  pet_id               BigInt
  appointment_type     String        @db.VarChar(50)
  appointment_date     DateTime      @db.Timestamptz(6)
  appointment_status   String        @db.VarChar(50)
  appointment_comments String?
  create_dtm           DateTime      @default(now()) @db.Timestamptz(6)
  last_updated_dtm     DateTime      @updatedAt @db.Timestamptz(6)
  booking_id           Int?
  Booking              PIQ_Bookings? @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_appt_booking")
  PIQ_Pets             PIQ_Pets      @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pet")

  @@index([pet_id])
  @@index([booking_id])
}

model PIQ_Reminders {
  reminder_id      Int       @id @default(autoincrement())
  user_id          BigInt
  pet_id           BigInt
  title            String    @db.VarChar(100)
  reminder_type    String    @db.VarChar(50)
  due_date         DateTime? @db.Timestamptz(6)
  priority         String    @default("normal") @db.VarChar(10)
  notes            String?   @db.VarChar(512)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm DateTime  @updatedAt @db.Timestamptz(6)
  PIQ_Pets         PIQ_Pets  @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction)
  PIQ_User         PIQ_User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([pet_id])
}

model password_reset_otps {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    BigInt
  email      String
  otp        String    @db.VarChar(6)
  is_used    Boolean?  @default(false)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  PIQ_User   PIQ_User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_otps_user_id")

  @@index([expires_at], map: "idx_otp_expires_at")
  @@index([used_at], map: "idx_otp_used_at")
  @@index([user_id], map: "idx_otp_user_id")
}

model PIQ_Admins {
  name                       String
  email                      String             @unique(map: "admins_email_key")
  password                   String
  role                       String             @default("admin")
  created_at                 DateTime           @default(now()) @db.Timestamptz(6)
  admin_id                   BigInt             @id
  TicketAssignmentAssignedBy TicketAssignment[] @relation("TicketAssignmentAssignedBy")
  TicketAssignmentAssignedTo TicketAssignment[] @relation("TicketAssignmentAssignedTo")
  TicketMessage              TicketMessage[]    @relation("TicketMessageAdminAuthor")
  chat_conversations         ChatConversation[] @relation("ChatConversationCreatedByAdmin")
  chat_participants          ChatParticipant[]  @relation("ChatParticipantAdmin")
  chat_messages              ChatMessage[]      @relation("ChatMessageAuthorAdmin")
}

model PIQ_Bookings {
  booking_id                    Int                            @id @default(autoincrement())
  pet_id                        BigInt
  services_id                   Int
  service_provider_id           Int?
  biz_dtls_id                   Int?
  user_id                       BigInt
  booked_dtm                    DateTime                       @db.Timestamptz(6)
  booking_status                String                         @db.VarChar(20)
  booking_comments              String?                        @db.VarChar(1000)
  created_dtm                   DateTime                       @default(now()) @db.Timestamptz(6)
  last_updated_dtm              DateTime?                      @default(now()) @db.Timestamp(6)
  cancellation_reason           String?                        @db.VarChar(500)
  cancelled_at                  DateTime?                      @db.Timestamptz(6)
  cancelled_by                  String?                        @db.VarChar(20)
  rescheduled_from              DateTime?                      @db.Timestamptz(6)
  Appointments                  PIQ_Appointments[]
  PIQ_Service_BizEntity_Details PIQ_Service_BizEntity_Details? @relation(fields: [biz_dtls_id], references: [biz_dtls_id], onUpdate: NoAction, map: "fk_booking_biz_entity")
  PIQ_Pets                      PIQ_Pets                       @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_pet")
  PIQ_Service_Master            PIQ_Service_Master             @relation(fields: [services_id], references: [services_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_service_master")
  PIQ_Service_Provider          PIQ_Service_Provider?          @relation(fields: [service_provider_id], references: [service_provider_id], onUpdate: NoAction, map: "fk_booking_service_provider")
  PIQ_User                      PIQ_User                       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_user")
  PIQ_Commission                PIQ_Commission[]
  PIQ_Payments                  PIQ_Payments[]
  PIQ_Provider_Reviews          PIQ_Provider_Reviews[]

  @@index([pet_id], map: "idx_bookings_pet_id")
  @@index([services_id], map: "idx_bookings_service_id")
  @@index([booking_status], map: "idx_bookings_status")
  @@index([user_id], map: "idx_bookings_user_id")
}

model PIQ_Payments {
  payment_id          Int             @id @default(autoincrement())
  booking_id          Int
  user_id             BigInt
  amount              Decimal         @db.Decimal(10, 2)
  currency            String          @default("INR") @db.VarChar(10)
  payment_method      String?         @db.VarChar(50)
  payment_status      String          @default("pending") @db.VarChar(20)
  razorpay_order_id   String?         @unique @db.VarChar(100)
  razorpay_payment_id String?         @db.VarChar(100)
  razorpay_signature  String?         @db.VarChar(255)
  payment_gateway     String          @default("razorpay") @db.VarChar(50)
  transaction_date    DateTime?       @db.Timestamptz(6)
  failure_reason      String?         @db.VarChar(500)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  last_updated_dtm    DateTime        @updatedAt @db.Timestamptz(6)
  PIQ_Commission      PIQ_Commission?
  PIQ_Bookings        PIQ_Bookings    @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, map: "fk_payment_booking")
  PIQ_User            PIQ_User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_payment_user")

  @@index([booking_id], map: "idx_payment_booking")
  @@index([user_id], map: "idx_payment_user")
  @@index([payment_status], map: "idx_payment_status")
  @@index([razorpay_order_id], map: "idx_payment_razorpay_order")
}

model PIQ_Service_BizEntity_Details {
  biz_dtls_id                    Int                @id @default(autoincrement())
  services_id                    Int
  provider_biz_name              String             @db.VarChar(100)
  provider_biz_email             String             @db.VarChar(255)
  provider_biz_login_name        String             @db.VarChar(255)
  provider_biz_pwd               String             @db.VarChar(50)
  provider_biz_contact_number    String             @db.VarChar(10)
  provider_biz_address           String             @db.VarChar(500)
  provider_biz_certificates      String?            @db.VarChar(500)
  provider_biz_gst_number        String?            @db.VarChar(75)
  is_provider_bizentity_verified Boolean            @default(false)
