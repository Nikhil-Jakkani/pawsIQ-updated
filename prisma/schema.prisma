model SupportTicket {
  ticket_id           Int                   @id @default(autoincrement())
  requester_id        BigInt
  service_provider_id Int?
  subject             String                @db.VarChar(200)
  description         String?               @db.VarChar(2000)
  category            String?               @db.VarChar(50)
  priority            String                @default("medium") @db.VarChar(20)
  status              String                @default("open") @db.VarChar(20)
  source              String?               @db.VarChar(30)
  first_response_at   DateTime?             @db.Timestamptz(6)
  resolved_at         DateTime?             @db.Timestamptz(6)
  closed_at           DateTime?             @db.Timestamptz(6)
  reopened_count      Int                   @default(0)
  sla_response_due    DateTime?             @db.Timestamptz(6)
  sla_resolution_due  DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @updatedAt @db.Timestamptz(6)
  provider            PIQ_Service_Provider? @relation(fields: [service_provider_id], references: [service_provider_id], map: "fk_support_ticket_provider")
  requester           PIQ_User              @relation(fields: [requester_id], references: [user_id], onDelete: Cascade, map: "fk_support_ticket_requester")
  assignments         TicketAssignment[]
  messages            TicketMessage[]
  sla_logs            TicketSLA[]

  @@index([status], map: "idx_support_ticket_status")
  @@index([priority], map: "idx_support_ticket_priority")
  @@index([service_provider_id], map: "idx_support_ticket_provider")
  @@index([requester_id], map: "idx_support_ticket_requester")
}

model TicketMessage {
  message_id         Int                   @id @default(autoincrement())
  ticket_id          Int
  author_user_id     BigInt?
  author_provider_id Int?
  author_admin_id    BigInt?
  author_role        String                @db.VarChar(20)
  message_body       String                @db.VarChar(2000)
  attachments        Json?                 @default("[]")
  created_at         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at         DateTime              @updatedAt @db.Timestamptz(6)
  admin_author       PIQ_Admins?           @relation("TicketMessageAdminAuthor", fields: [author_admin_id], references: [admin_id], map: "fk_ticket_message_admin")
  provider_author    PIQ_Service_Provider? @relation("TicketMessageProviderAuthor", fields: [author_provider_id], references: [service_provider_id], map: "fk_ticket_message_provider")
  ticket             SupportTicket         @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade, map: "fk_ticket_message_ticket")
  user_author        PIQ_User?             @relation("TicketMessageUserAuthor", fields: [author_user_id], references: [user_id], map: "fk_ticket_message_user")

  @@index([ticket_id], map: "idx_ticket_message_ticket")
  @@index([author_user_id], map: "idx_ticket_message_user")
  @@index([author_provider_id], map: "idx_ticket_message_provider")
  @@index([author_admin_id], map: "idx_ticket_message_admin")
}

