model PIQ_Commission {
  commission_id        Int                  @id @default(autoincrement())
  booking_id           Int
  payment_id           Int                  @unique(map: "uq_commission_payment")
  service_provider_id  Int
  booking_amount       Decimal              @db.Decimal(10, 2)
  commission_percent   Decimal              @default(15.00) @db.Decimal(5, 2)
  commission_amount    Decimal              @db.Decimal(10, 2)
  provider_amount      Decimal              @db.Decimal(10, 2)
  status               String               @default("pending") @db.VarChar(20)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  settled_at           DateTime?            @db.Timestamptz(6)
  PIQ_Bookings         PIQ_Bookings         @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_commission_booking")
  PIQ_Payments         PIQ_Payments         @relation(fields: [payment_id], references: [payment_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_commission_payment")
  PIQ_Service_Provider PIQ_Service_Provider @relation(fields: [service_provider_id], references: [service_provider_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_commission_provider")

  @@index([booking_id], map: "idx_commission_booking")
  @@index([payment_id], map: "idx_commission_payment")
  @@index([service_provider_id], map: "idx_commission_provider")
  @@index([status], map: "idx_commission_status")
  @@index([created_at], map: "idx_commission_created")
}
