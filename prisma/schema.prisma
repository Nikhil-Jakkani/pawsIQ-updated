model PIQ_Appointments {
  appointment_id       Int      @id @default(autoincrement())
  pet_id               BigInt
  appointment_type     String   @db.VarChar(50)
  appointment_date     DateTime @db.Timestamptz(6)
  appointment_status   String   @db.VarChar(50)
  appointment_comments String?
  create_dtm           DateTime @default(now()) @db.Timestamptz(6)
  last_updated_dtm     DateTime @updatedAt @db.Timestamptz(6)
  PIQ_Pets             PIQ_Pets @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pet")

  @@index([pet_id])
}

model PIQ_Reminders {
  reminder_id      Int       @id @default(autoincrement())
  user_id          BigInt
  pet_id           BigInt
  title            String    @db.VarChar(100)
  reminder_type    String    @db.VarChar(50)
  due_date         DateTime? @db.Timestamptz(6)
  priority         String    @default("normal") @db.VarChar(10)
  notes            String?   @db.VarChar(512)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_updated_dtm DateTime  @updatedAt @db.Timestamptz(6)
  PIQ_Pets         PIQ_Pets  @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction)
  PIQ_User         PIQ_User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([pet_id])
}

model password_reset_otps {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    BigInt
  email      String
  otp        String    @db.VarChar(6)
  is_used    Boolean?  @default(false)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  PIQ_User   PIQ_User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_otps_user_id")

  @@index([expires_at], map: "idx_otp_expires_at")
  @@index([used_at], map: "idx_otp_used_at")
  @@index([user_id], map: "idx_otp_user_id")
}

model PIQ_Admins {
  name       String
  email      String   @unique(map: "admins_email_key")
  password   String
  role       String   @default("admin")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  admin_id   BigInt   @id
}

model PIQ_Bookings {
  booking_id                    Int                            @id @default(autoincrement())
  pet_id                        BigInt
  services_id                   Int
  service_provider_id           Int?
  biz_dtls_id                   Int?
  user_id                       BigInt
  booked_dtm                    DateTime                       @db.Timestamptz(6)
  booking_status                String                         @db.VarChar(20)
  booking_comments              String?                        @db.VarChar(1000)
  created_dtm                   DateTime                       @default(now()) @db.Timestamptz(6)
  last_updated_dtm              DateTime?                      @default(now()) @db.Timestamp(6)
  PIQ_Service_BizEntity_Details PIQ_Service_BizEntity_Details? @relation(fields: [biz_dtls_id], references: [biz_dtls_id], onUpdate: NoAction, map: "fk_booking_biz_entity")
  PIQ_Pets                      PIQ_Pets                       @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_pet")
  PIQ_Service_Master            PIQ_Service_Master             @relation(fields: [services_id], references: [services_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_service_master")
  PIQ_Service_Provider          PIQ_Service_Provider?          @relation(fields: [service_provider_id], references: [service_provider_id], onUpdate: NoAction, map: "fk_booking_service_provider")
  PIQ_User                      PIQ_User                       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_user")

  @@index([pet_id], map: "idx_bookings_pet_id")
  @@index([services_id], map: "idx_bookings_service_id")
  @@index([booking_status], map: "idx_bookings_status")
  @@index([user_id], map: "idx_bookings_user_id")
}

model PIQ_Service_BizEntity_Details {
  biz_dtls_id                    Int                @id @default(autoincrement())
  services_id                    Int
  provider_biz_name              String             @db.VarChar(100)
  provider_biz_email             String             @db.VarChar(255)
  provider_biz_login_name        String             @db.VarChar(255)
  provider_biz_pwd               String             @db.VarChar(50)
  provider_biz_contact_number    String             @db.VarChar(10)
  provider_biz_address           String             @db.VarChar(500)
  provider_biz_certificates      String?            @db.VarChar(500)
  provider_biz_gst_number        String?            @db.VarChar(75)
  is_provider_bizentity_verified Boolean            @default(false)
  created_at                     DateTime           @default(now()) @db.Timestamptz(6)
  last_updated_dtm               DateTime?          @default(now()) @db.Timestamp(6)
  PIQ_Bookings                   PIQ_Bookings[]
  PIQ_Service_Master             PIQ_Service_Master @relation(fields: [services_id], references: [services_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bizentity_service_master")

  @@index([services_id], map: "idx_bizentity_service_id")
}

