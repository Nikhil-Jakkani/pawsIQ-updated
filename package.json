{
  "name": "pawsiq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --port 3001",
    "dev:backend": "cross-env NODE_ENV=development PORT=4000 tsx watch -r dotenv/config server/src/index.ts",
    "dev": "concurrently -k -n front,back -c cyan.bold,magenta.bold \"vite --port 3001\" \"cross-env NODE_ENV=development PORT=4000 nodemon --watch server/src --ext ts,js,json --signal SIGTERM --exec tsx -r dotenv/config server/src/index.ts\"",
    "build:frontend": "vite build",
    "build:backend": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "build": "npx vite build && npx tsc --project tsconfig.json && npx tsc-alias -p tsconfig.json",
    "start": "concurrently -k -n front,back -c cyan.bold,magenta.bold \"vite preview\" \"node -r dotenv/config server/dist/server/index.js\"",
    "start:frontend": "vite preview",
    "start:backend": "node -r dotenv/config server/dist/server/index.js",
    "lint": "eslint ."
  },
